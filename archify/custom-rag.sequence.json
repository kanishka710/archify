{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "RAG Query Execution Lifecycle",
    "subtitle": "End-to-end trace of a user query through authentication, similarity search, and streaming generation.",
    "output": "custom-rag-sequence.html",
    "viewBox": [1080, 560],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "user", "type": "external", "label": "User", "sublabel": "Browser / Client" },
    { "id": "api", "type": "backend", "label": "FastAPI Gateway", "sublabel": "Auth & Routing", "brand": "fastapi" },
    { "id": "auth", "type": "database", "label": "PostgreSQL", "sublabel": "Session & User DB", "brand": "postgresql" },
    { "id": "vector", "type": "database", "label": "ChromaDB", "sublabel": "HNSW Vector Index" },
    { "id": "llm", "type": "cloud", "label": "Groq / OpenAI", "sublabel": "Llama 3 / GPT-4", "brand": "openai" }
  ],
  "segments": [
    { "from": 150, "to": 255, "label": "1. Authentication & Guardrail" },
    { "from": 265, "to": 330, "label": "2. Vector Retrieval" },
    { "from": 340, "to": 445, "label": "3. Grounded Generation" }
  ],
  "messages": [
    { "id": "msg-query", "from": "user", "to": "api", "y": 170, "label": "POST /v1/chat/query", "variant": "emphasis" },
    { "id": "msg-auth", "from": "api", "to": "auth", "y": 205, "label": "verify session token", "variant": "security" },
    { "id": "msg-auth-ok", "from": "auth", "to": "api", "y": 240, "label": "session valid", "variant": "return" },
    { "id": "msg-search", "from": "api", "to": "vector", "y": 280, "label": "similarity_search(k=5)", "variant": "default" },
    { "id": "msg-search-res", "from": "vector", "to": "api", "y": 315, "label": "top-5 chunk context", "variant": "return" },
    { "id": "msg-prompt", "from": "api", "to": "llm", "y": 355, "label": "prompt + retrieved context", "variant": "emphasis" },
    { "id": "msg-stream", "from": "llm", "to": "api", "y": 390, "label": "token stream delta", "variant": "dashed" },
    { "id": "msg-response", "from": "api", "to": "user", "y": 425, "label": "SSE streamed response", "variant": "return" }
  ],
  "activations": [
    { "participant": "api", "from": 170, "to": 425, "type": "backend" },
    { "participant": "auth", "from": 205, "to": 240, "type": "database" },
    { "participant": "vector", "from": 280, "to": 315, "type": "database" },
    { "participant": "llm", "from": 355, "to": 390, "type": "cloud" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Auth Gate",
      "items": [
        "Validates Bearer token against session store",
        "Enforces tenant isolation and request rate limits",
        "Extracts user permissions before database access"
      ]
    },
    {
      "dot": "cyan",
      "title": "Hybrid Search",
      "items": [
        "Embeds question using vector embedding model",
        "Executes cosine similarity query in ChromaDB",
        "Returns top-k chunks with metadata provenance"
      ]
    },
    {
      "dot": "violet",
      "title": "Streaming Completion",
      "items": [
        "Formats system prompt with augmented citations",
        "Dispatches inference call with low latency",
        "Streams Server-Sent Events (SSE) back to client"
      ]
    }
  ]
}
